rules_version = '2';

// ============================================================
// firestore.rules — Reglas de seguridad de Viajoo.
//
// Reflejan exactamente lo que usa cloud.js hoy:
//   - users/{uid} -> copia de seguridad íntegra del usuario
//
// paid_query_usage/*, contact_message_quota/*, contact_messages/*,
// login_lockouts/* y email_action_quota/* (contadores/colas usados
// por functions/index.js) NO tienen regla propia a propósito: caen en
// el bloqueo por defecto de más abajo, así ningún cliente puede
// leerlos ni tocarlos directamente — solo el Admin SDK de las Cloud
// Functions, que no pasa por estas reglas.
// ============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Copia de seguridad personal (pushToCloud / pullFromCloud) ---
    // Solo el propio usuario puede leer o escribir su documento.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Cualquier otra ruta queda bloqueada por defecto.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
